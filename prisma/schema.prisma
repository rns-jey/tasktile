// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @default(uuid())
  userID String @unique
  name String
  imageUrl String @db.Text
  email String @db.Text @unique

  tasks Task[]
  stacks Stack[]
  categories Category[]
  tags Tag[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id String @id @default(uuid())
  name String
  description String @default("")
  completed Boolean @default(false)

  dueOn DateTime? @db.Date

  userId String
  user Profile @relation(fields: [userId], references: [userID])

  stackId String?
  stack Stack? @relation(fields: [stackId], references: [id], onDelete: SetNull)

  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags Tag[]

  completedAt DateTime?
  completedOn DateTime? @db.Date
  completedTz String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueOn])
  @@index([userId, completedOn])
  @@index([userId, createdAt])
  @@index([categoryId])
}

model Category {
  id String @id @default(uuid())
  name String
  nameKey String
  color String
  tasks Task[]

  userId String
  user Profile @relation(fields: [userId], references: [userID])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nameKey])
}

model Stack {
  id String @id @default(uuid())
  name String
  nameKey String

  tasks Task[]

  userId String
  user Profile @relation(fields: [userId], references: [userID])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId,nameKey])
}

model Tag {
  id String @id @default(uuid())
  name String
  nameKey String

  tasks Task[]
  
  userId String
  user Profile @relation(fields: [userId], references: [userID])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId,nameKey])
}